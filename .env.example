API_PROXY_TARGET=http://localhost:8080

# Keycloak public web client (never put a client secret in VITE_* variables).
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_WEB_CLIENT_ID=your-web-client

# Optional: set false to disable audio preload. Omitted means enabled.
# VITE_AUDIO_PRELOAD_ENABLED=false

# Backend root. Leave empty locally to use API_PROXY_TARGET via Vite.
# Required for static hosting unless /tracks and /albums APIs have a reverse proxy.
# VITE_API_BASE_URL=https://your-music-server.example
